{
    "manifest_version": 3,
    "name": "PB ESP - TH",
    "version": "2.8.41",
    "action": {
        "default_title": "PB ESP - TH"
    },
    "options_ui": {
        "page": "site/index.html",
        "open_in_tab": true
    },
    "description": "PB Mobile extension with ESP overlay, no-recoil, aim assist, and mobile bypass",
    "minimum_chrome_version": "111",
    "permissions": [
        "storage",
        "tabs",
        "declarativeNetRequest",
        "declarativeNetRequestWithHostAccess"
    ],
    "host_permissions": [
        "*://shootingpoint.xyz/*",
        "*://*.shootingpoint.xyz/*",
        "*://*.trycloudflare.com/*",
        "ws://*.shootingpoint.xyz/*",
        "wss://*.shootingpoint.xyz/*",
        "ws://*.trycloudflare.com/*",
        "wss://*.trycloudflare.com/*"
    ],
    "background": {
        "service_worker": "bg.js"
    },
    "content_scripts": [
        {
            "matches": [
                "*://shootingpoint.xyz/*",
                "*://*.shootingpoint.xyz/*",
                "*://*.trycloudflare.com/*"
            ],
            "js": ["mobile-spoof.js"],
            "run_at": "document_start",
            "world": "MAIN"
        },
        {
            "matches": [
                "*://shootingpoint.xyz/*",
                "*://*.shootingpoint.xyz/*",
                "*://*.trycloudflare.com/*"
            ],
            "js": ["injector.js"],
            "run_at": "document_start"
        }
    ],
    "web_accessible_resources": [
        {
            "resources": ["esp.js", "guard-patched.js"],
            "matches": [
                "*://shootingpoint.xyz/*",
                "*://*.shootingpoint.xyz/*",
                "*://*.trycloudflare.com/*"
            ]
        }
    ]
}
